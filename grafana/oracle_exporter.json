        "includeAll": true,
        "label": "RAC Node",
        "multi": false,
        "name": "inst_id",
        "options": [],
        "query": {"query": "label_values(oracle_session_count{instance=\"$instance\"}, inst_id)", "refId": "StandardVariableQuery"},
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {"selected": true, "text": "All", "value": "$__all"},
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "definition": "label_values(oracle_tablespace_used_bytes{instance=\"$instance\"}, pdb)",
