      "id": 1,
      "title": "Overview",
      "type": "row"
    },

    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 300},
              {"color": "green", "value": 3600}
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 7, "x": 0, "y": 1},
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "oracle_instance_uptime_seconds{instance=\"$instance\", inst_id=~\"$inst_id\"}",
          "legendFormat": "inst {{inst_id}}  {{instance_name}}  {{version}}  ({{status}})",
          "refId": "A"
        }
      ],
      "title": "Instance Uptime",
      "type": "stat"
    },

    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 300},
              {"color": "red", "value": 500}
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 5, "x": 7, "y": 1},
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "sum by (inst_id) (oracle_session_count{instance=\"$instance\", inst_id=~\"$inst_id\", pdb=~\"$pdb\", status=\"active\"})",
          "legendFormat": "inst {{inst_id}} active",
          "refId": "A"
        }
      ],
      "title": "Active Sessions",
      "type": "stat"
    },

    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Status"},
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "0": {"color": "red", "index": 0, "text": "FAILED"},
                      "1": {"color": "green", "index": 1, "text": "OK"}
                    },
                    "type": "value"
                  }
                ]
              },
              {"id": "custom.displayMode", "value": "color-background"},
              {"id": "custom.width", "value": 80}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Duration"},
            "properties": [
              {"id": "unit", "value": "s"},
              {"id": "decimals", "value": 3},
              {"id": "custom.width", "value": 90}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Collector"},
            "properties": [{"id": "custom.width", "value": 160}]
          }
        ]
      },
      "gridPos": {"h": 4, "w": 12, "x": 12, "y": 1},
      "id": 4,
      "options": {
        "cellHeight": "sm",
        "footer": {"countRows": false, "fields": "", "reducer": ["sum"], "show": false},
        "showHeader": true,
        "sortBy": [{"desc": false, "displayName": "Collector"}]
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "oracle_scrape_collector_success{instance=\"$instance\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "oracle_scrape_collector_duration_seconds{instance=\"$instance\"}",
          "format": "table",
          "instant": true,
          "refId": "B"
        }
      ],
      "title": "Collector Health",
      "transformations": [
        {
          "id": "joinByField",
          "options": {"byField": "collector", "mode": "outer"}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "__name__": true,
              "__name__ 1": true,
              "instance": true,
              "instance 1": true,
              "job": true,
              "job 1": true
            },
            "renameByName": {
              "collector": "Collector",
              "Value": "Status",
              "Value 1": "Duration"
            }
          }
        }
      ],
      "type": "table"
    },

