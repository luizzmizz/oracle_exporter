# oracle_exporter configuration reference
# Copy to config.yaml and edit for your environment.
#
# Global scrape timeout applied to every collector query.
scrape_timeout: 30s

# ---------------------------------------------------------------------------
# Global collector defaults — apply to all targets unless overridden.
#
# Each collector entry accepts:
#   enabled: true|false   (default: true when the field is absent)
#   include: [pattern, ...]  regex allowlist  — only names matching any pattern
#   exclude: [pattern, ...]  regex denylist   — drop names matching any pattern
#                            (applied after include)
#
# include/exclude only apply to high-cardinality collectors:
#   sysstat, syswaitclass, systimemodel, event
# ---------------------------------------------------------------------------
collectors:
  tablespace:
    enabled: true

  asm_diskgroup:
    enabled: true     # auto-runs on ASM targets; also runs on DB targets when enabled here or per-target

  session:
    enabled: true

  sysstat:
    enabled: true
    # Allowlist: collect only the most useful sysstat counters.
    # Comment out or remove include to collect everything.
    include:
      - "^physical reads$"
      - "^physical writes$"
      - "^redo size$"
      - "^parse count \\(hard\\)$"
      - "^execute count$"
      - "^user commits$"
      - "^user rollbacks$"
      - "^db block gets$"
      - "^consistent gets$"
      - "^sorts \\(disk\\)$"

  syswaitclass:
    enabled: true
    # Exclude idle wait classes to reduce noise.
    exclude:
      - "^Idle$"

  systimemodel:
    enabled: true
    # Collect only the most meaningful time model components.
    include:
      - "^DB time$"
      - "^DB CPU$"
      - "^sql execute elapsed time$"
      - "^parse time elapsed$"
      - "^hard parse elapsed time$"
      - "^PL/SQL execution elapsed time$"

  event:
    enabled: true
    # Exclude idle/background events to keep cardinality low.
    exclude:
      - "^SQL\\*Net"
      - "^pipe get$"
      - "^virtual circuit status$"
      - "^pmon timer$"
      - "^rdbms ipc message$"
      - "^smon timer$"
      - "^jobq slave wait$"

  flash_recovery_area:
    enabled: true

  uptime:
    enabled: true

  dataguard:
    enabled: false    # enable only on primary/standby pairs

  sanity:
    enabled: true     # detects datafiles sized beyond their maxsize (autoextend risk)


# ---------------------------------------------------------------------------
# Targets — one entry per Oracle instance/CDB/ASM you want to monitor.
#
# Connection fields (one of the following combinations):
#   connect_string              full Oracle connection string (takes priority)
#   host + service [+ port]     individual fields, port defaults to 1521
#
# Authentication:
#   username                    Oracle account (e.g. DBSNMP, C##DBSNMP for CDB)
#   password                    cleartext password
#   wallet_location             path to Oracle wallet directory; password can be
#                               omitted when the wallet contains credentials for
#                               the target connect string
#
# Privilege (required for ASM, optional for DB):
#   privilege: sysdba            connect AS SYSDBA  (asmsnmp always needs this)
#   privilege: sysoper           connect AS SYSOPER
#   privilege: sysasm            connect AS SYSASM  (rarely needed; use sysdba instead)
#
# Extra labels attached to every metric for this target:
#   labels:
#     environment: prod          any key/value pair; useful for Grafana/Alertmanager filtering
#     team: dba
#
# Per-target collector overrides — two syntaxes:
#   collectors:
#     <name>: true|false         shorthand — just enable or disable
#     <name>:                    full override — replace specific global fields
#       enabled: true|false
#       include: [...]           replaces the global include list for this target
#       exclude: [...]           replaces the global exclude list for this target
#   Absent fields inherit the global value. Only the fields you specify are replaced.
#
# Auto-detection (no config needed):
#   Instance name starts with +ASM  → ASM target; only asm_diskgroup runs
#   v$database.cdb = YES            → CDB; uses CDB_* views + gv$ with pdb/inst_id labels
#   otherwise                       → non-CDB; uses DBA_* views + gv$ with inst_id label
# ---------------------------------------------------------------------------
targets:

  # -------------------------------------------------------------------
  # CDB on a 2-node RAC
  # One connection covers all PDBs and all RAC nodes:
  #   tablespace metrics carry pdb + inst_id labels
  #   gv$ metrics carry inst_id label
  # -------------------------------------------------------------------
  prod-cdb:
    connect_string: "scan-vip:1521/PRODCDB"
    username: C##DBSNMP
    password: secret
    labels:
      environment: prod

  # -------------------------------------------------------------------
  # CDB with Data Guard: enable dataguard only on this target
  # -------------------------------------------------------------------
  prod-cdb-dg:
    connect_string: "scan-vip:1521/PRODCDB"
    username: C##DBSNMP
    password: secret
    collectors:
      dataguard:
        enabled: true

  # -------------------------------------------------------------------
  # ASM instance: auto-detected, only asm_diskgroup collector runs.
  # asmsnmp requires SYSDBA privilege (not SYSASM).
  # -------------------------------------------------------------------
  prod-asm:
    connect_string: "node1:1521/+ASM1"
    username: ASMSNMP
    password: secret
    privilege: sysdba

  # -------------------------------------------------------------------
  # Wallet-based authentication.
  # The wallet must contain an entry for the connect string.
  # TNS_ADMIN is resolved from wallet_location.
  # -------------------------------------------------------------------
  prod-cdb-wallet:
    connect_string: "scan-vip:1521/PRODCDB"
    username: C##DBSNMP
    wallet_location: /opt/oracle/wallet/prod

  # -------------------------------------------------------------------
  # Non-CDB (pre-12c or non-multitenant).
  # pdb label will be empty in all metrics.
  # -------------------------------------------------------------------
  legacy-db:
    host: 10.0.0.5
    port: 1521
    service: LEGACYDB
    username: DBSNMP
    password: secret

  # -------------------------------------------------------------------
  # DB target with ASM on the same host: enable asm_diskgroup directly
  # on the DB connection (shorthand syntax).
  # -------------------------------------------------------------------
  prod-db-with-asm:
    connect_string: "dbhost:1521/PRODDB"
    username: DBSNMP
    password: secret
    labels:
      environment: prod
    collectors:
      asm_diskgroup: true

  # -------------------------------------------------------------------
  # Dev CDB: disable event (shorthand), narrow sysstat to all counters
  # (full override syntax, dropping the global include filter).
  # -------------------------------------------------------------------
  dev-cdb:
    host: 10.0.0.10
    service: DEVCDB
    username: C##DBSNMP
    password: devpassword
    labels:
      environment: dev
    collectors:
      event: false
      sysstat:
        # no include/exclude: collect every sysstat counter (overrides global filter)
        enabled: true


# ---------------------------------------------------------------------------
# Prometheus scrape config  (prometheus.yml)
#
# scrape_configs:
#   - job_name: oracle
#     static_configs:
#       - targets: [prod-cdb, prod-asm, legacy-db, dev-cdb]
#     relabel_configs:
#       - source_labels: [__address__]
#         target_label: __param_target
#       - source_labels: [__param_target]
#         target_label: instance
#       - target_label: __address__
#         replacement: localhost:9161
# ---------------------------------------------------------------------------
